# Environment Configuration for jan-sunvai

# Server Configuration
PORT=3000
NODE_ENV=development

# Google Maps API
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API, Geocoding API, Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# DigiLocker API Configuration
# Register at: https://digilocker.meripehchaan.gov.in/
# Sandbox: https://api.digitallocker.gov.in/
DIGILOCKER_CLIENT_ID=your_digilocker_client_id_here
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret_here
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/digilocker/callback
DIGILOCKER_BASE_URL=https://api.digitallocker.gov.in/public/oauth2/1

# Security
SESSION_SECRET=your_random_session_secret_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
